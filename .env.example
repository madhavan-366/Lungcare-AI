# Backend Environment Variables (Render / Local)
FIREBASE_PROJECT_ID=lungcare-ai-34de7
FIREBASE_STORAGE_BUCKET=lungcare-ai-34de7.firebasestorage.app
# On Render, paste complete JSON in FIREBASE_SERVICE_ACCOUNT_JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# For local backend, point to your local serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# CORS allowed origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Frontend Environment Variables (project/frontend/.env)
VITE_API_BASE_URL=https://lungcare-ai-backend-vkov.onrender.com
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
